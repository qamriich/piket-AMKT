# Contoh .env untuk server produksi. Salin ke .env di server, lalu isi bagian bertanda <...>.
# Jangan commit .env yang sudah berisi password atau secret.

APP_NAME="Piket AMKT Putri"
APP_ENV=production
# Buat sekali di server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Alamat web yang dibuka warga, wajib https. Dipakai untuk link di email.
APP_URL=https://<domain-anda>
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<host-database>
DB_PORT=3306
DB_DATABASE=<nama-database>
DB_USERNAME=<user-database>
DB_PASSWORD=<password-database>

# Sesi, cache, dan antrean email disimpan di database (tidak butuh Redis atau worker yang terus jalan).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email lewat SMTP. Contoh Gmail: host smtp.gmail.com, port 587, password = App Password (bukan password Gmail).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="<email-pengirim>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Secret untuk /cron/tick. Hanya perlu kalau hosting tidak punya cron (lihat DEPLOY.md, cara B).
# Buat yang panjang dan acak: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=
CRON_MAKS_DETIK=40
